# Cloudflare Pages reads this file. Netlify reads netlify.toml instead, and the
# two say the same thing, so the site behaves identically on either host.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Astro fingerprints these filenames, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
