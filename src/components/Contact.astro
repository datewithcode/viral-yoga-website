---
import { site } from '../data/site';
import { isConfigured } from '../lib/supabase';
// Enquiries go to Supabase, which works on any host. The other two providers
// add a host-specific fallback for the rare case where that call fails.
const isNetlify = site.formProvider === 'netlify';
const isFormspree = site.formProvider === 'formspree';
const hasHostFallback = isNetlify || isFormspree;
const whatsappHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`;
---
<section id="contact" class="section bg-sand/40">
  <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.2fr]">
    <div>
      <h2 class="text-h2">{site.copy.contactHeading}</h2>
      <p class="mt-4 text-ink-soft">{site.copy.contactIntro}</p>
      <dl class="mt-8 space-y-5">
        <div>
          <dt class="text-sm text-ink-soft">Call or WhatsApp</dt>
          <dd class="mt-1 flex flex-wrap gap-x-5 gap-y-1 text-lg">
            <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="underline-offset-4 hover:underline">{site.phone}</a>
            <a href={whatsappHref} target="_blank" rel="noopener" class="underline-offset-4 hover:underline">Open WhatsApp</a>
          </dd>
        </div>
        <div>
          <dt class="text-sm text-ink-soft">Email</dt>
          <dd class="mt-1 text-lg"><a href={`mailto:${site.email}`} class="underline-offset-4 hover:underline">{site.email}</a></dd>
        </div>
        <div>
          <dt class="text-sm text-ink-soft">Studios</dt>
          <dd class="mt-1 text-ink-soft">
            {site.locations.map((l) => <span class="block">{l.name}: {l.addressLines.slice(0, 2).join(', ')}</span>)}
          </dd>
        </div>
      </dl>
    </div>

    <noscript>
      <style>#contact-form { display: none; }</style>
      <p class="rounded-lg border border-ink/15 bg-chalk p-6 text-ink-soft sm:p-8">
        This form needs JavaScript. Please message us on{' '}
        <a class="underline underline-offset-4" href={whatsappHref} target="_blank" rel="noopener">WhatsApp</a>{' '}
        or call <a class="underline underline-offset-4" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a> instead.
      </p>
    </noscript>

    <form
      id="contact-form"
      data-supabase={isConfigured ? 'true' : undefined}
      name="contact"
      method="POST"
      action={isNetlify ? '/thanks/' : isFormspree ? site.formspreeEndpoint : '/thanks/'}
      class="rounded-lg border border-ink/15 bg-chalk p-6 sm:p-8"
      {...(isNetlify ? { 'data-netlify': 'true', 'netlify-honeypot': 'bot-field' } : {})}
    >
      {isNetlify && <input type="hidden" name="form-name" value="contact" />}
      {isFormspree && <input type="hidden" name="_next" value={new URL('/thanks/', site.url).toString()} />}
      <p class="hidden">
        <label>Do not fill this in if you are human: <input name="bot-field" /></label>
      </p>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="name" class="label">Your name</label>
          <input id="name" name="name" type="text" required autocomplete="name" class="field" />
        </div>
        <div>
          <label for="phone" class="label">Phone or WhatsApp</label>
          <input id="phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" class="field" placeholder="+91" />
        </div>
        <div>
          <label for="email" class="label">Email (optional)</label>
          <input id="email" name="email" type="email" autocomplete="email" class="field" />
        </div>
        <div>
          <label for="location" class="label">Preferred studio</label>
          <select id="location" name="location" class="field">
            {site.locations.map((l) => <option value={l.name}>{l.name}</option>)}
            <option value="Either">Either</option>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="interest" class="label">Interested in</label>
          <select id="interest" name="interest" class="field">
            <option value="Free trial class">Free trial class</option>
            {site.classes.map((c) => <option value={c.name}>{c.name}</option>)}
            <option value="Something else">Something else</option>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="message" class="label">Message</label>
          <textarea id="message" name="message" rows="4" class="field" placeholder="Which days and times work for you?"></textarea>
        </div>
      </div>
      <button type="submit" id="contact-submit" class="btn-primary mt-6 w-full sm:w-auto">Send message</button>
      <p id="contact-error" class="mt-3 text-sm text-madder" hidden></p>
      <p class="mt-3 text-sm text-ink-soft">We only use your details to reply to you.</p>
    </form>
  </div>
</section>

<script>
  // Enquiries go to Supabase, which puts them on the admin page and emails a
  // copy. Only Netlify and Formspree offer somewhere to fall back to; on any
  // other host the honest answer is to point the visitor at WhatsApp rather
  // than post the form somewhere that will not accept it.
  import { supabase } from '../lib/supabase';
  import { site } from '../data/site';
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form && form.dataset.supabase && supabase) {
    let fallback = false;
    form.addEventListener('submit', async (e) => {
      if (fallback) return; // second pass: let the browser submit natively
      e.preventDefault();
      const btn = document.getElementById('contact-submit') as HTMLButtonElement;
      const err = document.getElementById('contact-error')!;
      err.hidden = true; btn.disabled = true; btn.textContent = 'Sending…';
      const body = Object.fromEntries(new FormData(form).entries());
      const { data, error } = await supabase!.functions.invoke('submit-enquiry', { body });
      if (!error && data?.ok) { location.href = form.getAttribute('action') || '/thanks/'; return; }
      // 4xx = the visitor can fix it; anything else (5xx, unreachable) = fall back to Netlify Forms.
      const status = Number((error as any)?.context?.status ?? 0);
      let detail = '';
      if (status >= 400 && status < 500) { try { detail = (await (error as any).context.json())?.error ?? ''; } catch {} }
      btn.disabled = false; btn.textContent = 'Send message';
      if (detail) { err.textContent = detail; err.hidden = false; return; }
      if (site.formProvider === 'netlify' || site.formProvider === 'formspree') {
        fallback = true; form.requestSubmit();
        return;
      }
      err.innerHTML = 'We could not send that just now. Please message us on '
        + '<a class="underline underline-offset-4" href="https://wa.me/' + site.whatsapp + '">WhatsApp</a>'
        + ' and we will reply the same day.';
      err.hidden = false;
    });
  }
</script>
