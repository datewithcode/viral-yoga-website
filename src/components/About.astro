---
import { site } from '../data/site';
const years = new Date().getFullYear() - site.foundedYear;
---
<section id="about" class="section">
  <div class="container-site grid items-center gap-12 lg:grid-cols-2">
    <div>
      <h2 class="text-h2">{site.copy.aboutHeading}</h2>
      <div class="mt-6 space-y-4 text-ink-soft">
        {site.copy.aboutParagraphs.map((text) => <p>{text}</p>)}
      </div>
      <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-ink/15 pt-6">
        <div>
          <dt class="text-sm text-ink-soft">Teaching since</dt>
          <dd class="font-display text-3xl">{site.foundedYear}</dd>
        </div>
        <div>
          <dt class="text-sm text-ink-soft">Studios</dt>
          <dd class="font-display text-3xl">{site.locations.length}</dd>
        </div>
        <div>
          <dt class="text-sm text-ink-soft">Years</dt>
          <dd class="font-display text-3xl">{years}</dd>
        </div>
      </dl>
    </div>
    <figure class="relative">
      <img src={site.aboutImage} alt="Teacher adjusting a student's posture during class" class="aspect-[4/5] w-full rounded-lg object-cover" loading="lazy" />
      <figcaption class="mt-3 text-sm text-ink-soft">{site.copy.aboutImageCaption}</figcaption>
    </figure>
  </div>
</section>
