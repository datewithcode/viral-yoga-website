  href={href}
  target="_blank"
  rel="noopener"
  class="fixed bottom-5 right-5 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-ink/20 transition-transform hover:scale-105 focus-visible:scale-105"
  aria-label="Chat with us on WhatsApp"
>
