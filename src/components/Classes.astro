---
import { site } from '../data/site';
---
<section id="classes" class="section bg-sand/40">
  <div class="container-site">
    <div class="max-w-2xl">
      <h2 class="text-h2">Classes</h2>
      <p class="mt-4 text-ink-soft">{site.copy.classesIntro}</p>
    </div>
    <ul class="mt-12 grid gap-px overflow-hidden rounded-lg border border-ink/15 bg-ink/15 sm:grid-cols-2 lg:grid-cols-3">
      {site.classes.map((c) => (
        <li class="flex flex-col bg-chalk p-6 sm:p-7">
          <h3 class="text-h3">{c.name}</h3>
          <p class="mt-3 flex-1 text-ink-soft">{c.description}</p>
          <p class="mt-5 text-sm text-ink-soft">{c.level} <span class="mx-2 text-ink/30">|</span> {c.duration}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
