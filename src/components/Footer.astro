---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="bg-ink text-chalk">
  <div class="container-site grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-2xl">{site.name}</p>
      <p class="mt-3 max-w-sm text-chalk/70">{site.tagline}</p>
      <div class="mt-6 flex gap-4 text-sm">
        {site.instagram && <a class="underline-offset-4 hover:underline" href={site.instagram} rel="noopener" target="_blank">Instagram</a>}
        {site.facebook && <a class="underline-offset-4 hover:underline" href={site.facebook} rel="noopener" target="_blank">Facebook</a>}
        <a class="underline-offset-4 hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="underline-offset-4 hover:underline" href="/my-membership/">My membership</a>
      </div>
    </div>
    {site.locations.map((l) => (
      <div class="text-chalk/80">
        <p class="font-medium text-chalk">{l.name}</p>
        <address class="mt-2 not-italic leading-relaxed">
          {l.addressLines.map((line) => <span class="block">{line}</span>)}
        </address>
        <a class="mt-2 inline-block underline-offset-4 hover:underline" href={`tel:${l.phone.replace(/\s/g, '')}`}>{l.phone}</a>
      </div>
    ))}
  </div>
  <div class="border-t border-chalk/15">
    <div class="container-site flex flex-col gap-2 py-5 text-sm text-chalk/60 sm:flex-row sm:justify-between">
      <span>© {year} {site.name}. Since {site.foundedYear}.</span>
      <span>Anjar · Adipur · Kutch, Gujarat</span>
    </div>
  </div>
</footer>
