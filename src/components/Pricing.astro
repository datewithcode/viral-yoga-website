---
import { site } from '../data/site';

const { pricing } = site;
const inr = (n: number) => '₹' + n.toLocaleString('en-IN');
const last = pricing.plans.length - 1;
---
<section id="pricing" class="section bg-ink text-chalk">
  <div class="container-site">
    <div class="max-w-2xl">
      <h2 class="text-h2">Fees</h2>
      <p class="mt-4 text-chalk/75">{pricing.intro}</p>
    </div>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {pricing.plans.map((p, i) => (
        <li class:list={['flex flex-col rounded-lg border p-6', i === last ? 'border-sand bg-chalk text-ink' : 'border-chalk/20']}>
          <h3 class="text-h3">{p.name}</h3>
          <p class="mt-3 font-display text-4xl tabular-nums">{inr(p.price)}</p>
          <p class:list={['mt-2 text-sm', i === last ? 'text-ink-soft' : 'text-chalk/65']}>{p.note}</p>
        </li>
      ))}
    </ul>

    <div class="mt-10">
      <a href="#contact" class="btn-primary">{site.copy.heroPrimaryButton}</a>
    </div>
  </div>
</section>
