---
import QRCode from 'qrcode';
import { site } from '../data/site';

const { pricing } = site;
const inr = (n: number) => '₹' + n.toLocaleString('en-IN');

const upiLink = (planName: string, amount: number) => {
  // Percent-encode (not '+') so every UPI app shows names and notes correctly.
  const enc = encodeURIComponent;
  return `upi://pay?pa=${pricing.upiId}&pn=${enc(pricing.upiPayeeName)}&am=${amount}&cu=INR&tn=${enc(`${site.shortName} ${planName}`)}`;
};

// QR codes are generated once at build time, so the page ships no QR library.
const plans = await Promise.all(
  pricing.plans.map(async (p) => {
    const link = upiLink(p.name, p.price);
    const qr = await QRCode.toString(link, { type: 'svg', margin: 1, color: { dark: '#1e2b48', light: '#ffffff' } });
    const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Hi, I have paid ${inr(p.price)} for the ${p.name} membership. My name is `)}`;
    return { ...p, link, qr, wa };
  }),
);
---
<section id="pricing" class="section bg-ink text-chalk">
  <div class="container-site">
    <div class="max-w-2xl">
      <h2 class="text-h2">Membership</h2>
      <p class="mt-4 text-chalk/75">{pricing.intro}</p>
    </div>

    <ul class="mt-12 grid items-start gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {plans.map((p, i) => (
        <li class:list={['flex flex-col rounded-lg border p-6', i === plans.length - 1 ? 'border-sand bg-chalk text-ink' : 'border-chalk/20']}>
          <h3 class="text-h3">{p.name}</h3>
          <p class="mt-3 font-display text-4xl tabular-nums">{inr(p.price)}</p>
          <p class:list={['mt-2 text-sm', i === plans.length - 1 ? 'text-ink-soft' : 'text-chalk/65']}>{p.note}</p>

          <div class="mt-6 flex flex-1 flex-col gap-3">
            <a
              href={`/my-membership/?plan=${encodeURIComponent(p.name)}`}
              class:list={[i === plans.length - 1 ? 'btn-primary' : 'btn-light']}
            >Buy online</a>

            <a
              href={p.link}
              class:list={['md:hidden text-center text-sm underline underline-offset-4', i === plans.length - 1 ? 'text-ink-soft' : 'text-chalk/75']}
              data-upi-link
            >Pay {inr(p.price)} by UPI instead</a>

            <details class="hidden md:block">
              <summary class:list={['cursor-pointer list-none text-center text-sm underline underline-offset-4', i === plans.length - 1 ? 'text-ink-soft' : 'text-chalk/75']}>Pay {inr(p.price)} by UPI instead</summary>
              <div class="mt-4 rounded-md bg-white p-3" set:html={p.qr} />
              <p class:list={['mt-2 text-xs', i === plans.length - 1 ? 'text-ink-soft' : 'text-chalk/65']}>
                Scan with any UPI app, or pay {inr(p.price)} to <span class="select-all font-medium">{pricing.upiId}</span>, then{' '}
                <a href={p.wa} target="_blank" rel="noopener" class="underline underline-offset-4">send us the screenshot</a>.
              </p>
            </details>
          </div>
        </li>
      ))}
    </ul>

    <p class="mt-8 max-w-2xl text-sm text-chalk/65">{pricing.afterPayment}</p>
  </div>
</section>

<style>
  details :global(svg) { width: 100%; height: auto; max-width: 220px; margin-inline: auto; display: block; }
</style>
