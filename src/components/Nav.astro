---
import { site } from '../data/site';
// Before online payment is on, only existing members can do anything after signing in.
const signinLabel = site.pricing.onlinePaymentsEnabled ? 'Sign in / Register' : 'Sign in';

// A link must not outlive the section it points at. Instructor.astro renders
// nothing while its achievements list is empty, which is exactly what the setup
// notes tell the owner to do while waiting for real content.
const hasTeacher = site.instructor.achievements.length > 0;
const links = [
  { href: '/#classes', label: 'Classes' },
  { href: '/#schedule', label: 'Schedule' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/#locations', label: 'Locations' },
  { href: '/#about', label: 'About' },
  ...(hasTeacher ? [{ href: '/#teacher', label: 'Teacher' }] : []),
  { href: '/#contact', label: 'Contact' },
];

// Passed to the inline greeting below, so it needs no bundling and can run
// before the first paint. Comes from lib/supabase.ts so it can never disagree
// with the key supabase-js actually writes.
import { projectRef } from '../lib/supabase';
---
<header class="sticky top-0 z-50 border-b border-ink/10 bg-chalk/90 backdrop-blur">
  <div class="container-site flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2.5 font-display text-xl tracking-tight text-ink" aria-label={`${site.name} home`}>
      {site.logo ? (
        <img src={site.logo} alt="" width="28" height="28" class="h-7 w-7 object-contain" />
      ) : (
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <circle cx="14" cy="14" r="13" stroke="currentColor" stroke-width="1.5"/>
          <path d="M14 5c-3 4-3 8 0 12 3-4 3-8 0-12Z" fill="currentColor"/>
          <path d="M7 12c3 0 6 2 7 5-4 1-7-1-7-5ZM21 12c-3 0-6 2-7 5 4 1 7-1 7-5Z" fill="currentColor" opacity=".7"/>
        </svg>
      )}
      <span>{site.shortName}</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class="text-[0.95rem] text-ink-soft hover:text-ink">{l.label}</a>
      ))}
      <a href="/my-membership/" class="btn-ghost !py-2.5 !px-5 text-sm" data-signin>{signinLabel}</a>
      <a href="/#contact" class="btn-primary !py-2.5 !px-5 text-sm">{site.copy.heroPrimaryButton}</a>
    </nav>

    <button
      id="nav-toggle"
      class="lg:hidden -mr-2 inline-flex h-10 w-10 items-center justify-center rounded-md text-ink"
      aria-expanded="false"
      aria-controls="nav-mobile"
      aria-label="Open menu"
    >
      <svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="icon-close hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <nav id="nav-mobile" class="hidden border-t border-ink/10 bg-chalk lg:hidden" aria-label="Main mobile">
    <div class="container-site flex flex-col py-3">
      {links.map((l) => (
        <a href={l.href} class="py-3 text-lg text-ink border-b border-ink/5 last:border-0">{l.label}</a>
      ))}
      <a href="/my-membership/" class="btn-ghost mt-4" data-signin>{signinLabel}</a>
      <a href="/#contact" class="btn-primary mt-3 mb-2">{site.copy.heroPrimaryButton}</a>
    </div>
  </nav>
</header>

<script is:inline define:vars={{ projectRef }}>
  // Show the signed-in state in the header without loading the Supabase library
  // on every page: the session is read from the storage key supabase-js uses.
  // Inline and unbundled on purpose, so the label is already right on the first
  // paint instead of flicking from "Sign in" to the member's name a moment later.
  try {
    var raw = projectRef ? localStorage.getItem('sb-' + projectRef + '-auth-token') : null;
    var session = raw ? JSON.parse(raw) : null;
    // A refresh token means supabase-js can restore the session by itself, so an
    // access token that expired an hour ago does not mean the member signed out.
    if (session && session.refresh_token) {
      // Use the cached name only if it was stored for the account signed in now.
      // Otherwise the studio's shared computer greets whoever used it last.
      var name = '';
      try {
        var cached = JSON.parse(localStorage.getItem('vy-member') || 'null');
        var uid = session.user && session.user.id;
        if (cached && uid && cached.id === uid) name = String(cached.name || '').trim().split(' ')[0];
      } catch (e) {}
      var label = name ? 'Hi, ' + name : 'Your membership';
      document.querySelectorAll('[data-signin]').forEach(function (a) {
        a.textContent = label;
        a.title = 'Your membership';
      });
    }
  } catch (e) {}
</script>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');
  if (toggle && menu) {
    const open = toggle.querySelector('.icon-open');
    const close = toggle.querySelector('.icon-close');
    const setOpen = (isOpen: boolean) => {
      menu.classList.toggle('hidden', !isOpen);
      open?.classList.toggle('hidden', isOpen);
      close?.classList.toggle('hidden', !isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    };
    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  }
</script>
