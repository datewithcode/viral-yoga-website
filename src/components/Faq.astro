---
// The questions the instructor answers on WhatsApp over and over. Answering
// them here removes the last reason not to walk in.
//
// The FAQPage data below does NOT buy rich results: Google restricted those to
// government and health sites in 2023 and withdrew them entirely in May 2026.
// It is kept because search engines and assistants still read it as a statement
// of studio policy, which is also the reason every answer must be confirmed.
import { site } from '../data/site';
const { faqs, copy, whatsapp } = site;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
{faqs.length > 0 && (
<section id="faq" class="section">
  <div class="container-site">
    <div class="max-w-2xl">
      <h2 class="text-h2">{copy.faqHeading}</h2>
      <p class="mt-4 text-ink-soft">{copy.faqIntro}</p>
    </div>

    <div class="mt-10 max-w-3xl border-t border-ink/15">
      {faqs.map((f) => (
        <details class="group border-b border-ink/10">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 font-medium">
            {f.q}
            <span aria-hidden="true" class="mt-1 shrink-0 text-ink-soft transition-transform group-open:rotate-45">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="pb-5 pr-8 text-ink-soft">{f.a}</p>
        </details>
      ))}
    </div>

    <p class="mt-8 text-ink-soft">
      Still not sure?{' '}
      <a class="underline underline-offset-4" href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener">Ask us on WhatsApp</a>{' '}
      or <a class="underline underline-offset-4" href="/#contact">book a free class</a>.
    </p>
  </div>
</section>
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
)}
