---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { isConfigured } from '../lib/supabase';
import SignIn from '../components/SignIn.astro';
---
<Base title="Membership" description="Join Viral Yoga or check your days remaining.">
  <section class="section">
    <div class="container-site max-w-xl">
      <h1 id="page-title" class="text-h2">Membership</h1>

      {!isConfigured && (
        <p class="mt-4 text-ink-soft">Online membership is not set up yet. Please pay by UPI on the <a href="/#pricing" class="underline underline-offset-4">pricing section</a> or contact the studio.</p>
      )}

      <div id="ask" hidden>
        <SignIn redirectPath="/my-membership/" />
        <p class="mt-8 text-sm text-ink-soft">
          Prefer to pay by UPI without signing in? Use the buttons on the{' '}
          <a class="underline underline-offset-4" href="/#pricing">pricing section</a>.
        </p>
      </div>

      <div id="checking" class="mt-4 text-ink-soft" hidden>Checking…</div>

      <div id="result" hidden>
        <p class="mt-2 text-sm text-ink-soft">Signed in as <span id="who-email" class="font-medium text-ink"></span>. <button id="signout" class="underline underline-offset-4">Sign out</button></p>

        <div id="cards" class="mt-6 space-y-4"></div>
        <p id="load-error" class="mt-4 text-madder" hidden>
          We could not load your membership just now. Please reload the page, or message us on{' '}
          <a class="underline underline-offset-4" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>.
        </p>
        <p id="none" class="mt-4 text-ink-soft" hidden>
          No membership found for this email. If you are a member, or you paid with different details, message us on{' '}
          <a class="underline underline-offset-4" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>.
        </p>

        <div id="buy" class="mt-10 rounded-lg border border-ink/15 bg-sand/30 p-6" hidden={!site.pricing.onlinePaymentsEnabled}>
          <h2 class="text-h3">Buy a membership</h2>
          <p class="mt-1 text-sm text-ink-soft">Pay by UPI, card or net banking. <span id="starts-line">Your membership starts today</span> and works at both studios.</p>
          <form id="buy-form" class="mt-5 grid gap-4 sm:grid-cols-2">
            <div>
              <label for="buy-name" class="label">Your name</label>
              <input id="buy-name" required minlength="2" autocomplete="name" class="field" />
            </div>
            <div>
              <label for="buy-phone" class="label">Mobile (WhatsApp)</label>
              <input id="buy-phone" required inputmode="tel" autocomplete="tel" placeholder="98765 43210" class="field" />
            </div>
            <fieldset class="sm:col-span-2">
              <legend class="label">Plan</legend>
              <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                {site.pricing.plans.map((p, i) => (
                  <label class="cursor-pointer rounded-md border border-ink/20 bg-chalk p-3 text-center has-[:checked]:border-ink has-[:checked]:bg-ink has-[:checked]:text-chalk">
                    <input type="radio" name="plan" value={p.name} class="sr-only" checked={i === 0} />
                    <span class="block text-sm">{p.name}</span>
                    <span class="block font-display text-xl">₹{p.price.toLocaleString('en-IN')}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="sm:col-span-2">
              <p id="pay-breakdown" class="mb-3 text-sm text-ink-soft"></p>
              <button type="submit" id="pay-btn" class="btn-primary w-full sm:w-auto">Pay now</button>
              <p id="pay-msg" class="mt-3 text-sm" hidden></p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
  import { supabase, inr, formatDate, daysUntil, syncHeader, watchHeader } from '../lib/supabase';
  import { site } from '../data/site';

  const $ = (id: string) => document.getElementById(id)!;

  if (supabase) {
    const show = (id: string) => {
      for (const s of ['ask', 'checking', 'result']) $(s).hidden = s !== id;
      $('page-title').textContent = id === 'result' ? 'Your membership' : (site.pricing.onlinePaymentsEnabled ? `Join ${site.name}` : 'Member sign-in');
    };
    const wantedPlan = new URLSearchParams(location.search).get('plan');
    if (site.pricing.onlinePaymentsEnabled && wantedPlan && site.pricing.plans.some((p) => p.name === wantedPlan)) {
      // SignIn.astro handles its own wording for a chosen plan; this only
      // preselects the matching radio in the buy panel further down.
      const radio = document.querySelector<HTMLInputElement>(`input[name="plan"][value="${wantedPlan}"]`);
      if (radio) radio.checked = true;
    }

    // ---- Sign in --------------------------------------------------------------
    // The form lives in SignIn.astro. It announces a successful code sign-in and
    // this page decides what happens next, which is: load their membership.
    document.addEventListener('vy:signedin', () => { void render(); });

    watchHeader();
    $('signout').addEventListener('click', async () => {
      await supabase!.auth.signOut();
      try { localStorage.removeItem('vy-member'); localStorage.removeItem('vy-member-name'); } catch {}
      show('ask');
    });

    // ---- Memberships ----------------------------------------------------------
    const todayIndia = () => new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
    const addDays = (iso: string, n: number) => { const d = new Date(iso + 'T00:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); };

    async function render() {
      const { data: { session } } = await supabase!.auth.getSession();
      if (!session) return show('ask');
      // The owner's account sees every member's rows here, which is confusing
      // and not what this page is for.
      if (session.user.app_metadata?.role === 'staff') { location.replace('/admin/'); return; }
      show('checking');
      $('who-email').textContent = session.user.email ?? '';

      const [{ data: memberships, error: mError }, { data: member, error: pError }] = await Promise.all([
        supabase!.from('memberships').select('plan, amount_paise, starts_on, ends_on').order('ends_on', { ascending: false }),
        supabase!.from('members').select('name, phone').limit(1).maybeSingle(),
      ]);
      show('result');
      const cards = $('cards');
      // A failed query must not look like "no membership".
      $('load-error').hidden = !(mError || pError);
      if (mError || pError) { $('none').hidden = true; cards.innerHTML = ''; return; }

      // Keyed to this account: the header only greets someone whose id matches.
      try {
        localStorage.setItem('vy-member', JSON.stringify({ id: session.user.id, name: member?.name || '' }));
      } catch {}

      // On the page you land on straight after clicking the emailed link, the
      // header script already ran, before this browser had a session at all, so
      // it still says "Sign in". Now that the name is cached, put it right.
      syncHeader(session);
      if (member) {
        const nameEl = $('buy-name') as HTMLInputElement, phoneEl = $('buy-phone') as HTMLInputElement;
        if (!nameEl.value) nameEl.value = member.name ?? '';
        if (!phoneEl.value) phoneEl.value = member.phone ?? '';
      }

      // A new plan starts the day after the latest one ends, never earlier, so
      // renewing early costs nothing.
      const today = todayIndia();
      const latestEnd = memberships?.length ? memberships[0].ends_on : '';
      const nextStart = latestEnd && addDays(latestEnd, 1) > today ? addDays(latestEnd, 1) : '';
      $('starts-line').textContent = nextStart ? `Your new membership starts on ${formatDate(nextStart)}, the day after your latest one ends,` : 'Your membership starts today';

      if (!memberships?.length) { $('none').hidden = false; cards.innerHTML = ''; return; }
      $('none').hidden = true;
      // Each card is judged by its own dates, not by its place in the list:
      // upcoming (paid early), current, or over. Only the newest finished one is
      // "Expired", and only when nothing is running; older ones are history.
      const anyRunning = memberships.some((x: any) => !(x.ends_on < today));
      const newestOver = memberships.find((x: any) => x.ends_on < today);
      cards.innerHTML = memberships.map((m: any) => {
        const d = daysUntil(m.ends_on);
        const upcoming = m.starts_on > today;
        const over = m.ends_on < today;
        const expired = over && m === newestOver && !anyRunning;
        const label = upcoming ? 'Upcoming membership' : !over ? 'Current membership' : expired ? 'Expired membership' : 'Earlier membership';
        const status = upcoming ? `Starts on ${formatDate(m.starts_on)}` : d > 0 ? `${d} day${d === 1 ? '' : 's'} remaining` : d === 0 ? 'Ends today' : `Ended ${-d} day${d === -1 ? '' : 's'} ago`;
        // An expired card must also say what to do next.
        const renew = !expired ? '' : site.pricing.onlinePaymentsEnabled
          ? '<p class="mt-3 text-sm">Renew below to start a new membership today.</p>'
          : `<p class="mt-3 text-sm">To renew, pay by UPI on the <a class="underline underline-offset-4" href="/#pricing">pricing section</a>, or message us on <a class="underline underline-offset-4" href="https://wa.me/${site.whatsapp}" target="_blank" rel="noopener">WhatsApp</a>.</p>`;
        return `
          <div class="rounded-lg border p-6 ${!over ? 'border-sage bg-sage-soft/40' : expired ? 'border-madder/40' : 'border-ink/15'}">
            <p class="text-sm text-ink-soft">${label}</p>
            <p class="mt-1 font-display text-3xl">${m.plan}</p>
            <p class="mt-3 text-lg ${expired ? 'text-madder' : ''}">${status}</p>
            <p class="mt-1 text-sm text-ink-soft">${formatDate(m.starts_on)} to ${formatDate(m.ends_on)} · ${inr(m.amount_paise)}</p>
            ${renew}
          </div>`;
      }).join('');
    }

    async function membershipCount() {
      const { count } = await supabase!.from('memberships').select('id', { count: 'exact', head: true });
      return count ?? 0;
    }
    // After a closed payment window, or a payment the bank is still confirming,
    // the membership can still turn up: the webhook records it and this page
    // can read it. Look a few times before going quiet.
    let watching = 0;
    function watchForMembership(seen: number) {
      const token = ++watching;
      let tries = 0;
      const tick = async () => {
        if (token !== watching || tries++ >= 8) return;
        if (await membershipCount() > seen) { say('Your payment went through. Your membership is below.'); await render(); return; }
        setTimeout(tick, 8000);
      };
      setTimeout(tick, 8000);
    }

    // ---- Buy ---------------------------------------------------------------------
    const payBtn = $('pay-btn') as HTMLButtonElement;
    const rupees = (n: number) => '₹' + n.toLocaleString('en-IN');
    function updateBreakdown() {
      const plan = document.querySelector<HTMLInputElement>('input[name="plan"]:checked')?.value;
      const price = site.pricing.plans.find((p) => p.name === plan)?.price ?? 0;
      const fee = Math.round(price * site.pricing.onlineFeePercent / 100);
      const total = price + fee;
      $('pay-breakdown').textContent = fee > 0 ? `${rupees(price)} + ${rupees(fee)} online payment fee = ${rupees(total)}` : '';
      payBtn.textContent = `Pay ${rupees(total)}`;
    }
    document.querySelectorAll<HTMLInputElement>('input[name="plan"]').forEach((r) => r.addEventListener('change', updateBreakdown));
    updateBreakdown();
    const payMsg = $('pay-msg');
    const say = (text: string, bad = false) => { payMsg.hidden = false; payMsg.textContent = text; payMsg.className = `mt-3 text-sm ${bad ? 'text-madder' : 'text-ink-soft'}`; };

    $('buy-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const plan = (document.querySelector<HTMLInputElement>('input[name="plan"]:checked'))?.value;
      const name = ($('buy-name') as HTMLInputElement).value.trim();
      const phone = ($('buy-phone') as HTMLInputElement).value.trim();
      if (!plan) return say('Choose a plan.', true);
      payBtn.disabled = true; say('Preparing payment…');

      const { data: order, error } = await supabase!.functions.invoke('create-order', { body: { plan, name, phone } });
      if (error || !order?.order_id) {
        let detail = error?.message ?? 'Unknown error';
        try { detail = (await (error as any)?.context?.json())?.error ?? detail; } catch {}
        payBtn.disabled = false; return say('Could not start payment: ' + detail, true);
      }

      const Razorpay = (window as any).Razorpay;
      if (!Razorpay) { payBtn.disabled = false; return say('Payment window could not load. Check your connection and try again.', true); }

      const seen = await membershipCount();
      const rzp = new Razorpay({
        key: order.key_id,
        amount: order.amount,
        currency: order.currency,
        name: site.name,
        description: `${order.plan} membership`,
        order_id: order.order_id,
        prefill: order.prefill,
        theme: { color: '#1e2b48' },
        modal: { ondismiss: () => {
          payBtn.disabled = false;
          // Closing the window does not always mean nothing happened: a UPI
          // request approved in the bank app afterwards still goes through.
          say('Payment window closed. If you approved a UPI request in your app, your membership will appear here in a minute. Reload before paying again.');
          watchForMembership(seen);
        } },
        handler: async (resp: any) => {
          say('Payment received. Activating your membership…');
          const { data, error } = await supabase!.functions.invoke('verify-payment', { body: resp });
          payBtn.disabled = false;
          if (error) {
            // 422: the payment can never be recorded automatically (for example a
            // wrong amount); it will not "appear later", the studio must add it.
            const status = (error as any)?.context?.status;
            if (status === 422) return say('Paid, but this payment needs the studio to check it. Message us with payment ID ' + resp.razorpay_payment_id, true);
            return say('Paid, but we could not confirm it yet. It will appear within a few minutes. If not, message us with payment ID ' + resp.razorpay_payment_id, true);
          }
          if (data?.ok) {
            watching++;
            say(data.starts_on && data.starts_on > todayIndia() ? `Done. Your ${data.plan} membership starts on ${formatDate(data.starts_on)}.` : `Done. Your ${data.plan} membership is active.`);
            await render();
          }
          else if (data?.failed) say(data.status === 'refunded' ? 'This payment was refunded, so no membership was added. Message us if that is unexpected.' : 'The payment did not go through. Nothing was charged. Please try again.', true);
          else if (data?.pending) { say('Payment is being confirmed by the bank. This page will update by itself within a minute.'); watchForMembership(seen); }
          else say('Paid, but something went wrong recording it. Message us with payment ID ' + resp.razorpay_payment_id, true);
        },
      });
      rzp.on('payment.failed', (r: any) => { payBtn.disabled = false; say('Payment failed: ' + (r?.error?.description ?? 'try again'), true); });
      rzp.open();
    });

    supabase.auth.onAuthStateChange(() => { render(); });
    render();
  }
</script>
