---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="section">
    <div class="container-site max-w-2xl">
      <h1 class="text-h2">That page does not exist</h1>
      <p class="mt-4 text-ink-soft">The link may be old or mistyped. Everything on this site is on the home page.</p>
      <a href="/" class="btn-ghost mt-8">Go to the home page</a>
    </div>
  </section>
</Base>
